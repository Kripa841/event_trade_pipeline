# ==============================================================================
# Trade Event Pipeline - Environment Configuration Template
# ==============================================================================
# Duplicate this file to '.env' for local development:
#   Copy-Item .env.example .env
#
# NOTE: The credentials below are for LOCAL DEMONSTRATION & DEVELOPMENT ONLY.
# Never commit production credentials to version control.
# ==============================================================================

# Kafka Configuration
# ------------------------------------------------------------------------------
# When connecting from local host (Windows PowerShell): localhost:29092
# When connecting inside Docker container network: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=trade-events
KAFKA_DLQ_TOPIC=trade-events-dlq
KAFKA_GROUP_ID=trade-processors

# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=trader
POSTGRES_PASSWORD=traderpass
POSTGRES_DB=tradesdb
POSTGRES_PORT=5432

# Database Connection URL (SQLAlchemy + Psycopg 3)
# Local host connection: postgresql+psycopg://trader:traderpass@localhost:5432/tradesdb
# Docker container connection: postgresql+psycopg://trader:traderpass@postgres:5432/tradesdb
DATABASE_URL=postgresql+psycopg://trader:traderpass@localhost:5432/tradesdb

